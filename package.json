{
  "name": "attendance-app",
  "version": "1.0.0",
  "description": "Attendance Clock-in Desktop Application",
  "author": "Antigravity",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.attendance.desktop",
    "productName": "考勤打卡桌面客户端",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!attendance_files/**/*",
      "!archive/**/*",
      "!dist/**/*"
    ]
  },
  "dependencies": {
    "@googleapis/docs": "^3.0.0",
    "@googleapis/sheets": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "googleapis": "^137.0.0",
    "nodemailer": "^6.10.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
